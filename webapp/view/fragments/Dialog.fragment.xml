<c:FragmentDefinition xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog contentWidth="25%"
        title="{
            parts: [
                'i18n>FEEDBACK_DIALOG_PREFIX',
                'ui>/appName'
            ]
        }"
        type="Message">
        <List items="{ui>/items}">
            <StandardListItem type="Active"
                title="{ui>title}"
                description="{ui>description}"
                icon="{ui>icon}"
                press="onListItemPress" />
        </List>
        <beginButton>
            <Button text="{i18n>CLOSE}"
                press="onCloseDialog" />
        </beginButton>
    </Dialog>
</c:FragmentDefinition>